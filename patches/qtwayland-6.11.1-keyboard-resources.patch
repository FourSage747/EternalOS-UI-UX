+void tst_WaylandCompositor::multipleKeyboardResources()
+{
+    TestCompositor compositor;
+    compositor.create();
+    auto *seat = compositor.defaultSeat();
+    seat->keymap()->setLayout("us");
+    MockClient client;
+    QTRY_COMPARE(client.m_seats.size(), 1);
+    auto *first = client.m_seats.first()->keyboard();
+    auto second = std::make_unique<MockKeyboard>(client.m_seats.first()->m_seat);
+    auto *surface = client.createSurface();
+    QTRY_COMPARE(compositor.surfaces.size(), 1);
+    seat->setKeyboardFocus(compositor.surfaces.first());
+    compositor.flushClients();
+    QTRY_COMPARE(first->m_enteredSurface, surface);
+    QTRY_COMPARE(second->m_enteredSurface, surface);
+
+    seat->sendKeyEvent(Qt::Key_A, true);
+    seat->sendKeyEvent(Qt::Key_A, false);
+    compositor.flushClients();
+    QTRY_COMPARE(first->m_keyCount, 2u);
+    QTRY_COMPARE(second->m_keyCount, 2u);
+    QCOMPARE(first->m_lastKeyCode, 30u);
+    QCOMPARE(second->m_lastKeyCode, 30u);
+
+    auto third = std::make_unique<MockKeyboard>(client.m_seats.first()->m_seat);
+    QTRY_COMPARE(third->m_enteredSurface, surface);
+    QCOMPARE(first->m_enterCount, 1u);
+    QCOMPARE(second->m_enterCount, 1u);
+    seat->keyboard()->setFocus(compositor.surfaces.first());
+    compositor.flushClients();
+    QCOMPARE(first->m_enterCount, 1u);
+
+    const auto keyboardPrivate = QWaylandKeyboardPrivate::get(seat->keyboard());
+    const auto shift = seat->keyboard()->keyToScanCode(Qt::Key_Shift);
+    keyboardPrivate->updateModifierState(shift, WL_KEYBOARD_KEY_STATE_PRESSED);
+    compositor.flushClients();
+    QTRY_VERIFY(first->m_modsDepressed != 0);
+    QTRY_COMPARE(second->m_modsDepressed, first->m_modsDepressed);
+    QTRY_COMPARE(third->m_modsDepressed, first->m_modsDepressed);
+    keyboardPrivate->updateModifierState(shift, WL_KEYBOARD_KEY_STATE_RELEASED);
+
+    // The mock seat binds v1 (no wl_keyboard.release); destroy the server
+    // resource explicitly to exercise the same destructor as release.
+    wl_resource_destroy(wl_client_get_object(compositor.surfaces.first()->waylandClient(),
+                        wl_proxy_get_id(reinterpret_cast<wl_proxy *>(third->m_keyboard))));
+    third.reset();
+    // Destroying the most recently bound resource must not stop the others.
+    seat->sendKeyEvent(Qt::Key_B, true);
+    seat->sendKeyEvent(Qt::Key_B, false);
+    compositor.flushClients();
+    QTRY_COMPARE(first->m_keyCount, 4u);
+    QTRY_COMPARE(second->m_keyCount, 4u);
+    QTRY_COMPARE(first->m_modsDepressed, 0u);
+    QTRY_COMPARE(second->m_modsDepressed, 0u);
+
+    seat->setKeyboardFocus(nullptr);
+    compositor.flushClients();
+    QTRY_VERIFY(!first->m_enteredSurface);
+    QTRY_VERIFY(!second->m_enteredSurface);
+    seat->sendKeyEvent(Qt::Key_C, true);
+    compositor.flushClients();
+    QCOMPARE(first->m_keyCount, 4u);
+    QCOMPARE(second->m_keyCount, 4u);
+
+    MockClient otherClient;
+    QTRY_COMPARE(otherClient.m_seats.size(), 1);
+    auto *otherKeyboard = otherClient.m_seats.first()->keyboard();
+    auto *otherSurface = otherClient.createSurface();
+    QTRY_COMPARE(compositor.surfaces.size(), 2);
+    seat->setKeyboardFocus(compositor.surfaces.last());
+    seat->sendKeyEvent(Qt::Key_D, true);
+    seat->sendKeyEvent(Qt::Key_D, false);
+    compositor.flushClients();
+    QTRY_COMPARE(otherKeyboard->m_enteredSurface, otherSurface);
+    QTRY_COMPARE(otherKeyboard->m_keyCount, 2u);
+    QCOMPARE(first->m_keyCount, 4u);
+    QCOMPARE(second->m_keyCount, 4u);
+    seat->setKeyboardFocus(compositor.surfaces.first());
+    compositor.flushClients();
+    QTRY_VERIFY(!otherKeyboard->m_enteredSurface);
+    QTRY_COMPARE(first->m_enterCount, 2u);
+    QTRY_COMPARE(second->m_enterCount, 2u);
+    wl_surface_destroy(otherSurface);
+    wl_surface_destroy(surface);
+}
